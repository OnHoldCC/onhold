{
  "schema_version": 1,
  "project": {
    "team_name": "default",
    "region_name": "rainbond",
    "app_name": "onhold"
  },
  "components": [
    {
      "name": "postgres",
      "role": "database",
      "image": "docker.1ms.run/library/postgres:16-bookworm",
      "port": 5432,
      "port_alias": "DATABASE",
      "env": {
        "POSTGRES_DB": "onhold",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "$POSTGRES_PASSWORD",
        "PGDATA": "/var/lib/postgresql/data/pgdata"
      },
      "connection_envs": {
        "DB_NAME": "onhold",
        "DB_USER": "onhold",
        "DB_PASS": "$DB_PASSWORD"
      },
      "storage": [
        {
          "volume_name": "postgres-data",
          "volume_type": "share-file",
          "volume_path": "/var/lib/postgresql/data"
        }
      ],
      "protocol": "tcp"
    },
    {
      "name": "redis",
      "role": "cache",
      "image": "docker.1ms.run/library/redis:7-bookworm",
      "port": 6379,
      "port_alias": "REDIS",
      "storage": [
        {
          "volume_name": "redis-data",
          "volume_type": "share-file",
          "volume_path": "/data"
        }
      ],
      "protocol": "tcp"
    },
    {
      "name": "api",
      "role": "service",
      "image": "registry.cn-hangzhou.aliyuncs.com/xmhxiansheng/singlespark:onhold-20261020-wallet-referral-v3",
      "port": 8080,
      "env": {
        "ONHOLD_ORIGIN": "https://onhold.cc",
        "ONHOLD_MARKET_ADDRESS": "0xa007D8a37C2ff82CBFf81900cE174D26945167AF",
        "ONHOLD_MARKET_FROM_BLOCK": "137853544",
        "ONHOLD_CHAIN_RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "ONHOLD_CHAIN_WS_URL": "wss://bsc-testnet-rpc.publicnode.com",
        "ONHOLD_BUYBACK_VAULT": "0xCf8bAa44aF89f3BDd5EEf2312305d7512C5De156",
        "ONHOLD_BUYBACK_FROM_BLOCK": "137853633",
        "ONHOLD_BUYBACK_FLAP_LIVE": "false"
      },
      "depends_on": [
        "postgres",
        "redis"
      ],
      "storage": [
        {
          "volume_name": "api-data",
          "volume_type": "share-file",
          "volume_path": "/data"
        }
      ]
    },
    {
      "name": "keeper",
      "role": "worker",
      "image": "registry.cn-hangzhou.aliyuncs.com/xmhxiansheng/singlespark:onhold-20261020-ads-keeper-v4",
      "command": "node backend/scripts/buyback-keeper.mjs --ads --mock",
      "env": {
        "ONHOLD_CHAIN_RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "ONHOLD_AD_REINVEST_MARKET": "0xa007D8a37C2ff82CBFf81900cE174D26945167AF",
        "ONHOLD_KEEPER_MAX_GAS_PRICE_GWEI": "1",
        "ONHOLD_KEEPER_SLIPPAGE_BPS": "100",
        "ONHOLD_KEEPER_DATA_DIR": "/data/keeper"
      },
      "storage": [
        {
          "volume_name": "keeper-data",
          "volume_type": "share-file",
          "volume_path": "/data"
        }
      ]
    }
  ]
}
