{
  "schema_version": 1,
  "project": {
    "team_name": "default",
    "region_name": "rainbond",
    "app_name": "onhold"
  },
  "components": [
    {
      "name": "postgres",
      "role": "database",
      "image": "docker.1ms.run/library/postgres:16-bookworm",
      "port": 5432,
      "port_alias": "DATABASE",
      "env": {
        "POSTGRES_DB": "onhold",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "$POSTGRES_PASSWORD",
        "PGDATA": "/var/lib/postgresql/data/pgdata"
      },
      "connection_envs": {
        "DB_NAME": "onhold",
        "DB_USER": "onhold",
        "DB_PASS": "$DB_PASSWORD"
      },
      "storage": [
        {
          "volume_name": "postgres-data",
          "volume_type": "share-file",
          "volume_path": "/var/lib/postgresql/data"
        }
      ],
      "protocol": "tcp"
    },
    {
      "name": "redis",
      "role": "cache",
      "image": "docker.1ms.run/library/redis:7-bookworm",
      "port": 6379,
      "port_alias": "REDIS",
      "storage": [
        {
          "volume_name": "redis-data",
          "volume_type": "share-file",
          "volume_path": "/data"
        }
      ],
      "protocol": "tcp"
    },
    {
      "name": "api",
      "role": "service",
      "image": "registry.cn-hangzhou.aliyuncs.com/xmhxiansheng/singlespark:onhold-20261022-readable-v60",
      "port": 8080,
      "env": {
        "ONHOLD_ORIGIN": "https://onhold.cc",
        "ONHOLD_MARKET_ADDRESS": "0x6dF5e9B6c29fdA32187f34653003617EC9e1A180",
        "ONHOLD_MARKET_FROM_BLOCK": "138068318",
        "ONHOLD_CHAIN_RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "ONHOLD_CHAIN_WS_URL": "wss://bsc-testnet-rpc.publicnode.com",
        "ONHOLD_BUYBACK_FROM_BLOCK": "138183417",
        "ONHOLD_BUYBACK_FLAP_LIVE": "true",
        "ONHOLD_BUYBACK_TOKEN_SYMBOL": "OHLDTEST",
        "ONHOLD_PREVIOUS_MARKET_ADDRESS": "0xc1719499434c74FCcCDfb574B9eAB27f3772DAA0",
        "ONHOLD_NFT_ADDRESS": "0xe6FCaf7da63c581afc22B27D0aCf27eB26645A1f",
        "ONHOLD_FLAP_BURN_TOKEN": "0xF98926D4f930a2345eA55D496e3214D37Bf17777"
      },
      "depends_on": [
        "postgres",
        "redis"
      ],
      "storage": [
        {
          "volume_name": "api-data",
          "volume_type": "share-file",
          "volume_path": "/data"
        }
      ]
    },
    {
      "name": "keeper",
      "role": "worker",
      "image": "registry.cn-hangzhou.aliyuncs.com/xmhxiansheng/singlespark:onhold-20261021-split-keeper-v5",
      "command": "node backend/scripts/buyback-keeper.mjs --ads --mock",
      "env": {
        "ONHOLD_CHAIN_RPC_URL": "https://bsc-testnet-rpc.publicnode.com",
        "ONHOLD_AD_REINVEST_MARKET": "0x6dF5e9B6c29fdA32187f34653003617EC9e1A180",
        "ONHOLD_KEEPER_MAX_GAS_PRICE_GWEI": "1",
        "ONHOLD_KEEPER_SLIPPAGE_BPS": "100",
        "ONHOLD_KEEPER_DATA_DIR": "/data/keeper-split-20261021",
        "ONHOLD_NFT_ADDRESS": "0xe6FCaf7da63c581afc22B27D0aCf27eB26645A1f"
      },
      "storage": [
        {
          "volume_name": "keeper-data",
          "volume_type": "share-file",
          "volume_path": "/data"
        }
      ]
    }
  ]
}
