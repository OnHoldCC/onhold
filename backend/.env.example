# Export these in your runtime; main.rs does not auto-load this file.
ONHOLD_ADDR=127.0.0.1:4190
ONHOLD_ORIGIN=http://127.0.0.1:4190
ONHOLD_DATA_DIR=backend/data
ONHOLD_DIST_DIR=front/dist
# Images use SingleSpark’s fixed Pons/IPFS endpoint; no R2/Cloudflare keys are needed.
# NFT mint verifier: set both, then configure its public address in the contract.
# ONHOLD_MARKET_ADDRESS=
# ONHOLD_VERIFIER_PRIVATE_KEY=
# PostgreSQL is the primary chain/analytics store; Redis is optional static metadata cache.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/onhold?sslmode=require
# REDIS_URL=rediss://USER:PASSWORD@HOST:6379/
# Shared WS stream for market and burn: WSS provider and exact deployment blocks.
# Two subscriptions on one connection; RPC is used for recovery and necessary chain checks.
# ONHOLD_CHAIN_WS_URL=wss://your-bnb-testnet-provider
# ONHOLD_CHAIN_RPC_URL=https://your-bnb-testnet-provider
# ONHOLD_MARKET_FROM_BLOCK=
# /api/chain reads PostgreSQL (Redis for fixed metadata only); it never triggers RPC per page/wallet.
# Confirmed buyback indexer: both required, plus ONHOLD_CHAIN_WS_URL above.
# ONHOLD_BUYBACK_VAULT=
# ONHOLD_BUYBACK_FROM_BLOCK=
# ONHOLD_BUYBACK_FLAP_LIVE=true
# Use false only for the standalone test ERC20 without a Flap processor.
# Separate npm run keeper process; dedicated testnet gas wallet.
# Policy: testnet minimum 0.001 BNB; mainnet policy 0.01 BNB (mainnet disabled).
# On-chain measured gas compensation capped at 0.0001 BNB after successful burn.
# Requires a real Flap tax token/processor bound directly to this vault.
# ONHOLD_KEEPER_PRIVATE_KEY=
# ONHOLD_KEEPER_MAX_GAS_PRICE_GWEI=
# ONHOLD_KEEPER_SLIPPAGE_BPS=100
# ONHOLD_KEEPER_DATA_DIR=backend/data/keeper

# Exact trusted reverse-proxy IPs; leave empty for direct connections.
ONHOLD_TRUSTED_PROXIES=

# npm run keeper:ads uses the market's 50% advertising reserve to buy Claude back into mining.
# ONHOLD_AD_REINVEST_MARKET=
# Set the worker wallet with setAdKeeper(address). Use separate wallets for burn and ad workers.
# The ad worker uses ONHOLD_KEEPER_* settings above; fund its gas separately.
# 100% of the reserved ad share goes to purchases; no gas refund is taken from it.
