{
  "name": "onhold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:build": "node contracts/scripts/compile.mjs",
    "build": "npm run build --workspace @onhold/front",
    "test": "node --test front/test/*.test.mjs contracts/test/*.test.mjs backend/test/*.test.mjs && cargo test --offline --manifest-path backend/Cargo.toml",
    "dev": "npm run build && cargo run --manifest-path backend/Cargo.toml",
    "pretest": "npm run contracts:build && cargo build --offline --manifest-path backend/Cargo.toml",
    "preview:static": "npm run preview --workspace @onhold/front",
    "keeper": "node backend/scripts/buyback-keeper.mjs",
    "keeper:ads": "node backend/scripts/buyback-keeper.mjs --ads",
    "predeploy:testnet": "npm run contracts:build",
    "deploy:testnet": "node contracts/scripts/deploy-testnet.mjs",
    "start:testnet": "node backend/scripts/start-testnet.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "solc": "^0.8.30"
  },
  "workspaces": [
    "front"
  ]
}
